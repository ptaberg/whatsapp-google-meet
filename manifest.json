{
  "manifest_version": 3,
  "name": "WhatsApp Meet Button",
  "version": "1.0.0",
  "description": "Adds a button to WhatsApp Web that puts a new Google Meet link in the open chat.",
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
