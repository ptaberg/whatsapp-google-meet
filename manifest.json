{
  "manifest_version": 3,
  "name": "Meet Button for WhatsApp Web",
  "version": "1.0.0",
  "description": "Add a new Google Meet link to the open WhatsApp Web chat in one click, then join when you send it.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
